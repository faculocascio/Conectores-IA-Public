# URL de tu frontend Zabbix (con o sin /api_jsonrpc.php)
ZABBIX_URL=https://zabbix.example.com

# Opción 1 – API Token (recomendado en Zabbix 7.x)
# Crea el token en: Administration → General → API tokens
ZABBIX_TOKEN=tu_api_token_aqui

# Opción 2 – Usuario y contraseña (si no usas token)
# ZABBIX_USER=Admin
# ZABBIX_PASSWORD=zabbix

# Puerto en el que escucha el servidor MCP (por defecto 8000)
PORT=8000
